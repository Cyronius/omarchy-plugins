#!/usr/bin/env python3
"""Rebuild the focused workspace as a grid of native Dwindle splits."""

import json
from math import isqrt
import os
from pathlib import Path
import re
import subprocess
import uuid


def hypr(*args):
    return subprocess.check_output(("hyprctl", *args), text=True).strip()


def dispatch(action):
    result = hypr("dispatch", action)
    if result != "ok":
        raise RuntimeError(result)


def layout(message):
    dispatch(f"hl.dsp.layout({json.dumps(message)})")


def selector(address):
    return json.dumps(f"address:{address}")


def focus(address):
    dispatch(f"hl.dsp.focus({{ window = {selector(address)} }})")


def move(address, workspace):
    dispatch(
        f"hl.dsp.window.move({{ window = {selector(address)}, "
        f"workspace = {json.dumps(workspace)}, follow = false }})"
    )


def tile(workspace, windows):
    target = workspace["name"]
    if not target.isdecimal():
        target = "name:" + target
    mode = f"o.workspace_mode({{ workspace = {json.dumps(target)}, mode = \"dwindle\" }})"
    hypr("eval", mode)
    if json.loads(hypr("-j", "activeworkspace"))["tiledLayout"] != "dwindle":
        raise RuntimeError("Could not switch the workspace to Dwindle")
    if workspace["id"] > 0:
        state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
        modes = state / "omarchy/workspace-layouts"
        modes.mkdir(parents=True, exist_ok=True)
        saved = modes / f'{workspace["id"]}.lua'
        temporary = saved.with_suffix(f".{os.getpid()}.tmp")
        temporary.write_text(mode + "\n")
        temporary.replace(saved)

    for window in windows:
        address = window["address"]
        dispatch(f"hl.dsp.window.float({{ window = {selector(address)}, action = \"off\" }})")
        if any(tag.rstrip("*") == "grid" for tag in window.get("tags", [])):
            dispatch(f"hl.dsp.window.tag({{ window = {selector(address)}, tag = \"-grid\" }})")
    if len(windows) == 1:
        return

    addresses = [window["address"] for window in windows]
    focused = workspace.get("lastwindow")
    staging = f"special:window-grid-{uuid.uuid4().hex}"
    pending = set()

    def place(items, direction):
        """Split the anchor, then independently subdivide its two children."""
        if len(items) < 2:
            return
        middle = (len(items) + 1) // 2
        first, second = items[:middle], items[middle:]
        focus(first[0])
        layout(f"preselect {direction}")
        move(second[0], target)
        pending.remove(second[0])
        focus(second[0])
        layout(f"splitratio {2 * middle / len(items):.6f} exact")
        place(first, direction)
        place(second, direction)

    try:
        # Leave the first tile in place so the focused workspace stays active.
        for address in addresses[1:]:
            move(address, staging)
            pending.add(address)
        columns = isqrt(len(addresses) - 1) + 1
        rows = [addresses[index:index + columns] for index in range(0, len(addresses), columns)]
        place([row[0] for row in rows], "d")
        for row in rows:
            place(row, "r")
    finally:
        # Clear any unconsumed preselection and bring back any staged windows
        # if the compositor rejects a step or a window closes during the move.
        subprocess.run(("hyprctl", "dispatch", 'hl.dsp.layout("preselect reset")'),
                       stdout=subprocess.DEVNULL, check=False)
        for address in addresses:
            if address in pending:
                try:
                    move(address, target)
                except (RuntimeError, subprocess.CalledProcessError):
                    pass
        if focused in addresses:
            focus(focused)


def main():
    workspace = json.loads(hypr("-j", "activeworkspace"))
    windows = sorted(
        (window for window in json.loads(hypr("-j", "clients"))
         if window["workspace"]["id"] == workspace["id"]
         and window["mapped"] and not window["hidden"] and not window["pinned"]
         and window["class"] != "local.omarchy.WindowOverview"
         and re.fullmatch("0x[0-9a-f]+", window["address"])),
        key=lambda window: (window["at"][1], window["at"][0]),
    )
    if workspace["hasfullscreen"]:
        raise RuntimeError("Exit fullscreen before arranging the grid")
    if windows:
        tile(workspace, windows)


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, subprocess.CalledProcessError, OSError, ValueError) as error:
        subprocess.run(("notify-send", "Tile windows", str(error)), check=False)
        raise SystemExit(1) from error
